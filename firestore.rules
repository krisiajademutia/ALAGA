rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users Collection ──────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;

      // Subcollection: Notifications
      match /notifications/{notifId} {
        allow read, write, delete: if true;
      }
    }

    // ── OTP state is private to trusted Cloud Functions ──
    match /otps/{otpId} {
      allow read, write: if false;
    }

    match /otpChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /otpRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /imageRateLimits/{userId} {
      allow read, write: if false;
    }

    // ── Rescues (Rescue Alerts) Collection ────────────────
    match /rescues/{rescueId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && (
        resource.data.reporterId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.authorId == request.auth.uid
      );

      // Subcollection: Comments
      match /comments/{commentId} {
        allow read, write, delete: if true;
      }
    }

    // ── Animals Collection ────────────────────────────────
    match /animals/{animalId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && (
        resource.data.advocateId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    // ── Applications Collection (Adoption / Foster) ───────
    match /applications/{applicationId} {
      allow read, write, delete: if true;
    }

    // ── Conversations & Messages ──────────────────────────
    match /conversations/{convId} {
      allow read, write, delete: if true;

      match /messages/{msgId} {
        allow read, write, delete: if true;
      }
    }

    // ── Donations Collection ──────────────────────────────
    match /donations/{donationId} {
      allow read, write, delete: if true;
    }
  }
}
