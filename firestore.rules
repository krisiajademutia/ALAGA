rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Users Collection ──────────────────────────────────
    match /users/{userId} {
      // Authenticated users can read member/advocate profiles
      allow read: if isAuthenticated();
      // Users can only create, update, or delete their own profile document
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && request.auth.uid == userId;

      // Subcollection: Notifications
      match /notifications/{notifId} {
        // Authenticated users can send a notification to a user
        allow create: if isAuthenticated();
        // Users can only read, update, or delete their own notifications
        allow read, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // ── OTPs Collection (Brevo verification codes) ────────
    match /otps/{otpId} {
      allow read, write, delete: if true;
    }

    match /otpChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /otpRateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /imageRateLimits/{userId} {
      allow read, write: if false;
    }

    // ── Rescues (Rescue Alerts) Collection ────────────────
    match /rescues/{rescueId} {
      // Rescues are open for anyone in the community to view
      allow read: if true;
      // Must be logged in to report or update rescue alerts
      allow create, update: if isAuthenticated();
      // Only the original reporter can delete their rescue alert
      allow delete: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.authorId == request.auth.uid
      );

      // Subcollection: Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.authorId == request.auth.uid
        );
      }
    }

    // ── Animals Collection ────────────────────────────────
    match /animals/{animalId} {
      // Adoption catalog is publicly browsable
      allow read: if true;
      // Only logged-in advocates can create or update listings
      allow create, update: if isAuthenticated();
      // Only the listing owner/advocate can delete it
      allow delete: if isAuthenticated() && (
        resource.data.advocateId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    // ── Applications Collection (Adoption / Foster) ───────
    match /applications/{applicationId} {
      // Private: only authenticated participants (applicant or advocate) can view
      allow read: if isAuthenticated() && (
        resource.data.advocateId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.applicantId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.advocateId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.applicantId == request.auth.uid
      );
    }

    // ── Conversations & Messages ──────────────────────────
    match /conversations/{convId} {
      allow read, write: if isAuthenticated();

      match /messages/{msgId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Donations Collection ──────────────────────────────
    match /donations/{donationId} {
      allow read, write: if isAuthenticated();
    }
  }
}
