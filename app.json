{
  "expo": {
    "name": "ALAGA",
    "slug": "alaga-app",
    "scheme": "alaga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alaga.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ALAGA needs camera access to take photos of animals for rescue reports and profiles.",
        "NSPhotoLibraryUsageDescription": "ALAGA needs photo library access to attach images to rescue reports.",
        "NSLocationWhenInUseUsageDescription": "ALAGA uses your location to pinpoint the animal's rescue location."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.alaga.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ALAGA needs access to your photos to attach images to rescue reports.",
          "cameraPermission": "ALAGA needs camera access to take photos for rescue reports."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ALAGA uses your location to tag the rescue location."
        }
      ],
      "expo-web-browser",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "b48c0f28-8465-4a59-b502-b138a64114e0"
      }
    },
    "owner": "krisiajade"
  }
}
